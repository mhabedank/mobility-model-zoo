{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipients"
  ],
  "properties": {
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "route_id": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "hosting_provider": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_call": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_call": {
            "type": [
              "string",
              "null"
            ]
          },
          "calls_ok": {
            "type": "integer"
          },
          "calls_error": {
            "type": "integer"
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "route_id",
          "model_id",
          "backend",
          "hosting_provider",
          "roles",
          "first_call",
          "last_call",
          "calls_ok",
          "calls_error",
          "runs"
        ]
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
