{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhabedank/mobility-model-zoo/catalog/run.schema.json",
  "title": "Discovery run header (runs/<date>-<slug>.yaml, feature 009)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "kind", "scope", "method", "agent", "cost", "outcome"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "kind": {"type": "string", "pattern": "^(harvester:[a-z0-9-]+|agent)$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["languages", "areas", "subdomains", "modalities"],
      "properties": {
        "languages": {"type": "array", "items": {"type": "string"}},
        "areas": {"type": "array", "items": {"type": "string"}},
        "subdomains": {"type": "array", "items": {"type": "string"}},
        "modalities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "method": {"type": "string", "minLength": 1},
    "agent": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["tool", "model_id"],
      "properties": {
        "tool": {"type": "string"}, "model_id": {"type": "string"}, "model_version": {"type": ["string", "null"]}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false, "required": ["cash_eur"],
      "properties": {"cash_eur": {"type": "number", "minimum": 0}, "notes": {"type": "string"}}
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "proposed": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "merged": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "by_cell": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["language", "modality", "proposed", "accepted"],
            "properties": {
              "language": {"type": "string"}, "modality": {"type": "string"},
              "proposed": {"type": "integer"}, "accepted": {"type": "integer"}
            }
          }
        },
        "rejected_lines": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["line", "reason"],
            "properties": {"line": {"type": "integer"}, "reason": {"type": "string"}}
          }
        }
      }
    }
  }
}
