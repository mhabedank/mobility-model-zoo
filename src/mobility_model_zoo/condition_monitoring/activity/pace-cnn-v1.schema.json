{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pace-cnn-v1.schema.json",
  "title": "pace-cnn example (format pace-cnn-v1)",
  "description": "One int8 input window of pace-cnn and the expected int8 scores of the bit-exact host reference (feature 021, contracts/records.md). Inputs are synthetic: they check the arithmetic, not an activity.",
  "type": "object",
  "required": ["format", "source", "generator", "input", "expected"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "pace-cnn-v1"},
    "source": {"const": "synthetic"},
    "generator": {
      "type": "object",
      "required": ["name", "version", "seed"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "index": {"type": "integer", "minimum": 0, "description": "position in the generated sequence"}
      }
    },
    "input": {
      "description": "1,152 int8 values, row-major 128 samples x 9 channels in the channel order of config.json",
      "type": "array",
      "minItems": 1152,
      "maxItems": 1152,
      "items": {"type": "integer", "minimum": -128, "maximum": 127}
    },
    "expected": {
      "description": "6 int8 scores in label order (config.json labels)",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "integer", "minimum": -128, "maximum": 127}
    }
  }
}
