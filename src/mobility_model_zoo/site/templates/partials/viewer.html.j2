<section class="sec" id="examples" aria-labelledby="ex-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Worked examples</div><h2 class="h2" id="ex-h">Every quote can be found again in the text.</h2>
<p class="muted">Outputs of version {{ p.latest.version }} for the example texts published with the model, taken from its model card. The texts are fictional.{% if p.examples and p.examples[0].span_format %} Select a marked quote or a JSON item to see its partner.{% endif %}</p></div>
{% for ex in p.examples %}
<article class="example" id="ex{{ ex.n }}" aria-labelledby="ex{{ ex.n }}-h">
<h3 class="h3" id="ex{{ ex.n }}-h">Example {{ ex.n }}: <code>{{ ex.file }}</code></h3>
{% if ex.span_format %}
<div class="kinds" aria-label="Kinds"><span>job</span><span class="pain">pain</span><span class="gain">gain</span></div>
<div class="viewer">
<div class="vtext" lang="{{ ex.lang }}">{% for s in ex.segments %}{% if s.marked %}<a class="hl {{ s.kind }}" id="ex{{ ex.n }}-q{{ s.item }}" href="#ex{{ ex.n }}-i{{ s.item }}" data-pair="ex{{ ex.n }}-i{{ s.item }}" title="{{ s.kind }}, characters {{ s.start }} to {{ s.end }}">{{ s.text }}<span class="visually-hidden"> ({{ s.kind }})</span></a>{% else %}{{ s.text }}{% endif %}{% endfor %}</div>
<div>
{% if ex.found %}
<ol class="jlist">
{% for it in ex.found %}<li><a class="jitem" id="ex{{ ex.n }}-i{{ it.index }}" href="#ex{{ ex.n }}-q{{ it.index }}" data-pair="ex{{ ex.n }}-q{{ it.index }}"><span class="kind {{ it.kind }}">{{ it.kind }}</span><pre>{{ it.json }}</pre></a></li>
{% endfor %}
</ol>
{% else %}
<p class="empty">No items. An empty list is a valid result.</p>
{% endif %}
</div>
</div>
{% else %}
<div class="grid2">
<div class="code"><div class="code-top"><span>input</span></div><pre class="wrap-pre"><code>{{ ex.text }}</code></pre></div>
<div class="code"><div class="code-top"><span>output</span></div><pre class="wrap-pre"><code>{{ ex.json }}</code></pre></div>
</div>
{% endif %}
<details><summary>Full output of example {{ ex.n }}</summary>
<div class="code"><div class="code-top"><span>json</span><button class="copy" type="button" data-copy="ex{{ ex.n }}-json">Copy</button></div><pre id="ex{{ ex.n }}-json" class="wrap-pre"><code>{{ ex.json }}</code></pre></div>
</details>
</article>
{% endfor %}
</div></section>
