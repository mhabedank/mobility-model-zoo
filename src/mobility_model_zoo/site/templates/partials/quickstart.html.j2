<section class="sec" id="quickstart" data-layer="quickstart" aria-labelledby="qs-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Quickstart</div><h2 class="h2" id="qs-h">{% if p.quick and p.quick.device %}Install, calibrate, detect.{% else %}Install, load, extract.{% endif %}</h2>
<p class="muted">{{ p.hardware_note }}</p>
{% if p.usage["class"].startswith("non-commercial") %}<p class="notice" role="note"><strong>Non-commercial use only.</strong> {{ p.usage.text }}</p>{% endif %}</div>
<ol class="steps" style="list-style:none;padding:0">
<li class="step"><h3>Install version {{ p.latest.version }}</h3>
<div class="code"><div class="code-top"><span>shell</span><button class="copy" type="button" data-copy="qs-install">Copy</button></div><pre id="qs-install"><code>{{ p.install }}</code></pre></div></li>
<li class="step"><h3>{% if p.quick and p.quick.device %}Run it on CAN frames{% else %}Run it on a text{% endif %}</h3>
<div class="code"><div class="code-top"><span>python</span><button class="copy" type="button" data-copy="qs-run">Copy</button></div><pre id="qs-run" class="wrap-pre"><code>{{ p.how_to_run }}</code></pre></div></li>
{% if p.quick %}
<li class="step"><h3>Get this output</h3>
{% if p.quick.device %}
<p class="small muted" style="margin-bottom:10px">For the example <code>{{ p.quick.file }}</code>, the released C code returns:</p>
<div class="code"><div class="code-top"><span>json · expected result of v{{ p.latest.version }}, reproduced bit-exactly by the release gate</span>
{% else %}
<p class="small muted" style="margin-bottom:10px">For the example text <code>{{ p.quick.file }}</code>, the released model returns:</p>
<div class="code"><div class="code-top"><span>json · output of v{{ p.latest.version }}, from the published model card</span>
{% endif %}<button class="copy" type="button" data-copy="qs-out">Copy</button></div><pre id="qs-out" class="wrap-pre"><code>{{ p.quick.json }}</code></pre></div></li>
{% endif %}
</ol>
</div></section>
