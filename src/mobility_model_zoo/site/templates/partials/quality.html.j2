<section class="sec" id="quality" data-layer="quality" aria-labelledby="q-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Quality and speed</div><h2 class="h2" id="q-h">How good, how fast, measured on a frozen benchmark and named hardware.</h2></div>
{% if p.benchmark or p.checks %}
<div class="checks" role="note">
{% if p.benchmark %}<span>Benchmark <strong class="mono">{{ p.benchmark }}</strong> (frozen)</span>{% endif %}
{% for c in p.checks %}<span>{{ c.description }}: <strong>{{ c.value }}</strong></span>{% endfor %}
</div>
{% endif %}
{% if p.cards %}
<div class="grid3" style="margin-bottom:32px">
{% for c in p.cards %}
<div class="metric"><div class="cap">{{ c.label }}</div><div class="v">{{ c.m.value }}{% if c.m.unit %} <small>{{ c.m.unit }}</small>{% endif %}<sup><a href="#fn-{{ c.note }}" aria-label="Note {{ c.note }}">{{ c.note }}</a></sup></div>
{% if c.compare %}<div class="ref">vs. {{ c.compare.m.value }}{% if c.compare.m.unit %} {{ c.compare.m.unit }}{% endif %} for the {{ c.compare.label }}</div>{{ c.bar }}{% endif %}
<div class="hw">{{ c.m.against | ucfirst }}.</div></div>
{% endfor %}
</div>
{% endif %}
{% if p.charts %}
<div class="grid2" style="margin-bottom:32px">
{% for ch in p.charts %}
<figure class="chart">
<figcaption>{{ ch.caption }}</figcaption>
{{ ch.html }}
<p class="cap">{{ ch.note }}</p>
<details><summary>Values of this chart</summary><div class="tw"><table class="tbl">
<thead><tr>{% for c in ch.columns %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
<tbody>{% for r in ch.rows %}<tr>{% for cell in r %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table></div></details>
</figure>
{% endfor %}
</div>
{% endif %}
<p><a href="#metrics">All metrics of version {{ p.latest.version }}</a>, with what each one is measured against.</p>
</div></section>
