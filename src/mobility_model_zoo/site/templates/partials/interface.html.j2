<div class="sec" id="interface"><div class="wrap stack" style="gap:28px">
<div class="sec-head" style="margin:0"><div class="eyebrow">Interface</div><h2 class="h2" id="if-h">What goes in, what comes out.</h2></div>
<div class="prose">{{ p.m.card.input_output | md }}</div>
{% if p.fmt %}
{% set fmt = p.fmt %}
<div class="grid2">
<div class="stack"><h3 class="h3">Input</h3><ul class="small">{% for line in fmt.input %}<li>{{ line | md | striptags }}</li>{% endfor %}</ul></div>
<div class="stack"><h3 class="h3">Guarantees</h3><ul class="small">{% for line in fmt.rules %}<li>{{ line | md }}</li>{% endfor %}</ul></div>
</div>
<p class="reference-link">Every field, its allowed values, edge cases and versioning: <a href="{{ root }}formats/{{ fmt.id }}/">output format {{ fmt.id }}</a> · <a href="{{ p.schema_url }}">JSON schema</a>.</p>
{% endif %}
</div></div>
