<section class="hero" id="top" aria-labelledby="title">
<div class="wrap hero-in">
<div class="stack" style="gap:20px">
<div class="row" style="gap:10px">
<span class="eyebrow">{{ p.topic.title }} · {{ p.m.task }}</span>
<span class="chip{% if p.status == 'deprecated' %} deprecated{% endif %}"><i></i>{{ p.status }} · v{{ p.latest.version }}</span>
</div>
<h1 class="h-display" id="title">{{ p.name }}</h1>
<p class="lead">{{ p.tagline }}</p>
<p class="muted">{{ p.audience }}</p>
<div class="row" style="gap:8px">
{% for lang in p.m.languages %}<span class="chip">{{ {"de": "German", "en": "English"}.get(lang, lang) }}</span>{% endfor %}
<span class="chip">Licence {{ p.m.license }}</span>
<span class="chip">Output {{ p.latest.output_format_version }}</span>
</div>
<div class="row"><a class="btn" href="#quickstart">Quickstart</a><a class="btn btn-ghost" href="#interface">Interface</a><a class="btn btn-ghost" href="{{ p.hf }}">Model card</a></div>
</div>
<div class="hero-art">{{ motif(p.pitch.get("motif") | replace(".svg", "-hero.svg"), 0) }}</div>
</div>
</section>
