<section class="sec" id="provenance" aria-labelledby="pv-h"><div class="wrap stack" style="gap:24px">
<div class="sec-head" style="margin:0"><div class="eyebrow">Licence and provenance</div><h2 class="h2" id="pv-h">What you may do with it, and what it was trained on.</h2></div>
<div class="tw"><table class="tbl"><tbody>
<tr><th scope="row">Licence</th><td>{{ p.m.license }}</td></tr>
{% if p.m.get("base_model") %}<tr><th scope="row">Base model</th><td><a href="https://huggingface.co/{{ p.m.get("base_model") }}">{{ p.m.get("base_model") }}</a>, {{ p.m.base_model_license }}</td></tr>{% endif %}
{% if p.latest.links.get("training_data_summary") %}<tr><th scope="row">Training data</th><td><a href="{{ p.latest.links.get("training_data_summary") }}">Training-data summary and source attribution of v{{ p.latest.version }}</a></td></tr>{% endif %}
{% if p.latest.links.get("ai_act") %}<tr><th scope="row">AI Act</th><td><a href="{{ p.latest.links.get("ai_act") }}">AI Act note of v{{ p.latest.version }}</a></td></tr>{% endif %}
{% if p.latest.links.get("compliance") %}<tr><th scope="row">Compliance record</th><td><a href="{{ p.latest.links.get("compliance") }}">Compliance record of v{{ p.latest.version }}</a></td></tr>{% endif %}
<tr><th scope="row">Model files</th><td><a href="{{ p.hf }}">{{ p.m.repos.public }} on Hugging Face</a>{% if p.latest.links.get("hf_tree") %} · <a href="{{ p.latest.links.get("hf_tree") }}">files of v{{ p.latest.version }}</a>{% endif %}</td></tr>
{% if p.recipe %}<tr><th scope="row">Recipe</th><td><a href="{{ p.recipe }}">How the model is built and measured</a></td></tr>{% endif %}
<tr><th scope="row">Code</th><td><a href="{{ site.repo }}">{{ site.repo | replace("https://", "") }}</a></td></tr>
<tr><th scope="row">Privacy</th><td>Texts can contain personal data. The model does not remove it; redact texts before sharing outputs. How the training texts were collected and how to object: <a href="{{ site.legal.privacy }}">privacy notice</a>.</td></tr>
</tbody></table></div>
</div></section>
