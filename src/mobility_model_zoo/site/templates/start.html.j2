{% extends "base.html.j2" %}
{% block main %}
{# feature 016: the hero image is the emotional stage; text stays on a solid panel (FR-004). #}
{% if hero_image %}
<section class="hero hero-full" aria-labelledby="title">
<div class="hero-panel scheme-dark"><div class="hero-panel-in stack" style="gap:20px">
<div class="eyebrow">Vision</div>
<h1 class="h-display" id="title">{{ site.tagline }}</h1>
<p class="lead" style="max-width:640px">{{ site.lead }}</p>
<div class="row"><a class="btn" href="#models">Browse the models</a><a class="btn btn-ghost" href="{{ root }}quickstart/">Try it in five minutes</a><a class="btn btn-ghost" href="#principles">Read the principles</a></div>
</div></div>
<figure class="hero-stage"><img data-image="{{ hero_image.id }}" src="{{ hero_image.src }}" srcset="{{ hero_image.srcset }}" sizes="(min-width: 860px) 55vw, 100vw" width="{{ hero_image.width }}" height="{{ hero_image.height }}" alt="{{ hero_image.alt }}" fetchpriority="high" decoding="async" style="object-position:{{ hero_image.position }}"></figure>
</section>
{% else %}
<section class="hero" aria-labelledby="title"><div class="wrap stack" style="gap:20px;max-width:1200px">
<div class="eyebrow">Vision</div>
<h1 class="h-display" id="title" style="max-width:900px">{{ site.tagline }}</h1>
<p class="lead muted" style="max-width:760px">{{ site.lead }}</p>
<div class="row"><a class="btn" href="#models">Browse the models</a><a class="btn btn-ghost" href="{{ root }}quickstart/">Try it in five minutes</a><a class="btn btn-ghost" href="#principles">Read the principles</a></div>
</div></section>
{% endif %}
{% if site["values"] %}
<section class="sec" aria-label="What every model has"><div class="wrap grid3">
{% for v in site["values"] %}<div class="stack" style="gap:6px"><h2 class="h3">{{ v.title }}</h2><p class="muted small">{{ v.text }}</p></div>{% endfor %}
</div></section>
{% endif %}
<section class="sec" id="models" aria-labelledby="m-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Models</div><h2 class="h2" id="m-h">{{ linked | length }} published · {{ upcoming | length }} coming next.</h2></div>
<div class="grid3">
{% for sm in models | rejectattr("status", "equalto", "in_progress") | sort(attribute="status", reverse=True) %}
{% set topic = topics | selectattr("id", "equalto", sm.m.topic) | first %}
{% set ti = model_images.get(sm.name) %}
{% set inner %}
{% if ti %}<figure class="tile-img"><img data-image="{{ ti.id }}" src="{{ ti.src }}" srcset="{{ ti.srcset }}" sizes="(min-width: 860px) 50vw, 100vw" width="{{ ti.width }}" height="{{ ti.height }}" alt="{{ ti.alt }}" loading="lazy" decoding="async" style="object-position:{{ ti.position }}"></figure>{% endif %}
<div class="tile-top"><span class="tile-name">{{ motif(sm.motif, 64, plate=72) }}<span class="h3" style="font-size:20px">{{ sm.name }}</span></span>
<span class="chip{% if sm.status == 'in_progress' %} wip{% elif sm.status == 'deprecated' %} deprecated{% endif %}"><i></i>{{ {"published": "published", "deprecated": "deprecated", "in_progress": "in progress"}[sm.status] }}</span></div>
<p class="small">{{ sm.m.title }}</p>
<dl><dt>Topic</dt><dd>{{ topic.title if topic else sm.m.topic }}</dd><dt>Task</dt><dd>{{ sm.m.task }}</dd><dt>Latest</dt><dd class="mono">{{ sm.latest or "none yet" }}</dd><dt>Usage</dt><dd>{{ sm.usage["class"] }}</dd></dl>
{% endset %}
{% if sm.name in linked %}<a class="tile" href="models/{{ sm.name }}/">{{ inner }}</a>{% else %}<div class="tile">{{ inner }}</div>{% endif %}
{% endfor %}
</div>
{% include "partials/upcoming.html.j2" %}
</div></section>
<section class="sec" id="topics" aria-labelledby="t-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Topics</div><h2 class="h2" id="t-h">{{ topics | length }} fields, one way of working.</h2></div>
<div class="grid3">
{% for t in topics %}
{% set ti = topic_images.get(t.id) %}
<div class="card stack" style="gap:8px">
{% if ti %}<figure class="topic-img"><img data-image="{{ ti.id }}" src="{{ ti.src }}" srcset="{{ ti.srcset }}" sizes="(min-width: 860px) 33vw, 100vw" width="{{ ti.width }}" height="{{ ti.height }}" alt="{{ ti.alt }}" loading="lazy" decoding="async" style="object-position:{{ ti.position }}"></figure>{% endif %}
<h3 class="h3" style="font-size:20px">{{ t.title }}</h3><p class="small muted">{{ t.description }}</p>{% if t.hf_collection %}<a class="small" href="{{ topic_url(t) }}">Collection on Hugging Face</a>{% endif %}
{% set ns = namespace(found=false) %}
{% for sm in models if sm.m.topic == t.id and sm.status != "in_progress" and sm.motif %}{% if not ns.found %}<div class="topic-plates" aria-hidden="true">{% set ns.found = true %}{% endif %}{{ motif(sm.motif, 28, plate=36) }}{% endfor %}{% if ns.found %}</div>{% endif %}
</div>
{% endfor %}
</div>
</div></section>
<section class="sec" id="principles" aria-labelledby="p-h"><div class="wrap">
<div class="sec-head"><div class="eyebrow">Principles</div><h2 class="h2" id="p-h">What the zoo stands for.</h2></div>
<div class="grid2">
{% for pr in site.principles %}<div class="stack" style="gap:6px"><h3 class="h3">{{ pr.title }}</h3><p class="muted">{{ pr.text }}</p></div>{% endfor %}
</div>
</div></section>
{% endblock %}
