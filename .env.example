# Copy to .env (gitignored) and fill in.

# OpenRouter key for the GPT reference model. Set a hard spending limit of EUR 12 on this key
# in the OpenRouter UI (constitution: Resources & Cost Discipline).
OPENROUTER_API_KEY=
# Separate key for feature 004 teacher labeling (budget span-xlmr-0.1.0, USD 20 hard limit)

# Ollama on the DGX Spark (teacher candidates and baseline quality runs).
OLLAMA_HOST=http://spark:11434

# Ollama on the low-resource reference VM (performance runs only).
OLLAMA_HOST_VM=

# Reddit Data API credentials (Reddit for Researchers). Reddit text is benchmark_only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=jtbd-pilot/0.1 (research)

# Hugging Face release tool `zoo` (specs/003-model-zoo-hf-release/contracts/workflows.md).
# Release token: fine-grained, write access to the mobility-model-zoo organization's repos and
# collections. Also stored as the GitHub repository secret HF_RELEASE_TOKEN. Owner's machine only.
HF_RELEASE_TOKEN=
# Staging token: fine-grained, write access only to the listed <model>-staging repos, no org rights.
# Training machines only.
HF_STAGING_TOKEN=

# Compliance harness (feature 006): random secret for keyed (HMAC) hashes of request identifiers
# and suppression entries. Generate once, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Never commit it; losing it means existing suppression hashes can no longer be matched.
MMZ_SUPPRESSION_KEY=

# Feature 005: dataset cache outside the repository (default ~/.cache/mobility-model-zoo/datasets).
# MMZ_DATA=
# HIL_RUNNER_ENABLED is a GitHub repository variable, not a local setting (docs/credentials.md).
# HIL_RUNNER_ENABLED=false

# DGX Spark as user@host for the Spark scripts (train_span.sh, scripts/spark/tracking-pull.sh).
SPARK_HOST=

# Feature 017: experiment tracking. The MLflow server runs on this laptop (scripts/mlflow/mlflow.sh up),
# usually http://127.0.0.1:5000; leave empty to disable live tracking (every command then behaves as
# without it).
MLFLOW_TRACKING_URI=
# 1: training on the Spark writes an offline run log next to its outputs (train_span.sh passes it into
# the container); fetch and sync with scripts/spark/tracking-pull.sh. A tracking URI wins on this laptop.
MMZ_TRACKING_OFFLINE=
# Store and backups of the laptop server (defaults: ~/.local/share/mobility-model-zoo/mlflow and
# ~/mlflow-backups; point the backups at an external drive if you like).
# MMZ_TRACKING_HOME=
# MMZ_TRACKING_BACKUP=

# Feature 009: mobility resource index (`zoo catalog`). Private catalog repository checkout.
# MMZ_CATALOG=../mobility-model-zoo-catalog
# Free keys for the pilot harvesters (docs/credentials.md).
# Mobility Database: refresh token from mobilitydatabase.org → account details.
MOBILITYDATABASE_REFRESH_TOKEN=
# OpenAlex: openalex.org/settings/api (free daily budget; the harvester stops before it).
OPENALEX_API_KEY=
# Podcast Index (free key and secret from podcastindex.org; `zoo catalog harvest podcast-index`).
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
