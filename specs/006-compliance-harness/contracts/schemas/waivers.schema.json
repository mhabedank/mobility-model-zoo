{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "waivers"
  ],
  "properties": {
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string",
            "pattern": "^C-[A-Z][0-9]$"
          },
          "scope": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "expires_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        },
        "required": [
          "id",
          "check",
          "scope",
          "rationale",
          "approved_by",
          "approved_at",
          "expires_at"
        ]
      }
    }
  }
}
