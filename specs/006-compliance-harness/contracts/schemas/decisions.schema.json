{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisions"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-?[A-Za-z0-9._-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_by": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "decided_by": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "date",
          "decision",
          "rationale",
          "scope",
          "review_by",
          "decided_by"
        ]
      }
    }
  }
}
