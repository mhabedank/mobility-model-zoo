{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "court",
              "legislation",
              "guidance"
            ]
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_by": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "reviewed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "expected",
          "review_by",
          "reviewed_at",
          "outcome",
          "affects"
        ]
      }
    }
  }
}
