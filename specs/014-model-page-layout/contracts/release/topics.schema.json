{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topics.schema.json",
  "title": "Zoo topics (zoo/topics.yaml)",
  "type": "object",
  "required": ["topics"],
  "additionalProperties": false,
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "hf_collection"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 24},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "hf_collection": {"type": ["string", "null"]}
        }
      }
    }
  }
}
