{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "next_review": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "unknown_checked_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "notes": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "privacy_contact": {
      "type": "string",
      "format": "email"
    },
    "general_contact": {
      "type": "string"
    },
    "imprint_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "website_privacy_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "supervisory_authority": {
      "type": "string"
    },
    "commercial_activity": {
      "const": "none"
    }
  },
  "required": [
    "name",
    "privacy_contact",
    "general_contact",
    "imprint_url",
    "website_privacy_url",
    "supervisory_authority",
    "commercial_activity",
    "owner",
    "last_reviewed",
    "next_review"
  ]
}
