{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "models"
  ],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "remote_code",
          "weights_licence",
          "training_data_named",
          "training_data",
          "used_by",
          "owner",
          "last_reviewed",
          "next_review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "remote_code": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo",
                  "revision"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[\\w.-]+/[\\w.-]+$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            ]
          },
          "weights_licence": {
            "type": "string",
            "minLength": 1
          },
          "training_data_named": {
            "type": "boolean"
          },
          "training_data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "url",
                "licence"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "licence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "base_model",
                    "stage"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "last_reviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "next_review": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "training_data_named": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "training_data": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
