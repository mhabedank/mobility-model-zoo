{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classes"
  ],
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "last_reviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "next_review": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "unknown_checked_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}"
          },
          "notes": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "description": {
            "type": "string"
          },
          "copyright_basis": {
            "enum": [
              "tdm_44b",
              "official_work_5",
              "licence"
            ]
          },
          "gdpr_legal_basis": {
            "enum": [
              "art6_1_f",
              "none_needed"
            ]
          },
          "lia": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "type": "string"
              },
              "necessity": {
                "type": "string"
              },
              "balancing": {
                "type": "string"
              },
              "safeguards": {
                "type": "string"
              },
              "decided_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              }
            },
            "required": [
              "purpose",
              "necessity",
              "balancing",
              "safeguards",
              "decided_at"
            ]
          },
          "art9_handling": {
            "enum": [
              "quarantine",
              "allowed_by_decision",
              "not_applicable"
            ]
          },
          "decision_id": {
            "type": "string"
          },
          "retention_purpose": {
            "type": "string"
          },
          "retention_rule": {
            "type": "string"
          },
          "platform_terms": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "description",
          "copyright_basis",
          "gdpr_legal_basis",
          "lia",
          "art9_handling",
          "retention_purpose",
          "retention_rule",
          "owner",
          "last_reviewed",
          "next_review"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "art9_handling": {
                  "const": "allowed_by_decision"
                }
              }
            },
            "then": {
              "required": [
                "decision_id"
              ]
            }
          }
        ]
      }
    }
  }
}
