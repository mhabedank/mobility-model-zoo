{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhabedank/mobility-model-zoo/catalog/fetch-list.schema.json",
  "title": "Fetch list (feature 009)",
  "description": "A dated selection of cleared entries handed to a later download feature. proposed_record follows compliance/schemas/sources.schema.json (texts, audio, video, images) or datasets.schema.json (structured data), without the fetch-time fields storage, retention_until, crawl_manifest_sha256 and pii_scan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created_at", "selection", "catalog_commit", "catalog_sha256", "vocab_version", "rules_version", "items", "refused"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"},
    "created_at": {"type": "string"},
    "selection": {"type": "string", "description": "The query as given to `zoo catalog fetchlist`."},
    "catalog_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vocab_version": {"type": "integer"},
    "rules_version": {"type": "integer"},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_id", "access_route", "target_register", "proposed_record"],
        "properties": {
          "entry_id": {"type": "string"},
          "access_route": {"type": "object"},
          "target_register": {"enum": ["sources", "datasets"]},
          "target_topic": {"type": "string"},
          "proposed_record": {"type": "object"}
        }
      }
    },
    "refused": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["entry_id", "reason"],
        "properties": {"entry_id": {"type": "string"}, "reason": {"type": "string"}}
      }
    }
  }
}
